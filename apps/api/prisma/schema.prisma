// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(uuid())
  // Nullable since email+password auth: a user can register with a password and never link a
  // Google account. Still @unique - two Google accounts can't map to one row. The invariant
  // "at least one of googleId / passwordHash is set" isn't expressible here; UsersService
  // enforces it (never creates a User without one).
  googleId     String? @unique
  email        String  @unique
  passwordHash String?
  displayName  String?
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  links Link[]
}

model Link {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  originalUrl  String
  shortCode    String   @unique
  isCustomAlias Boolean @default(false)
  title        String?
  isActive     Boolean  @default(true)
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clicks Click[]

  // Composite, not just @@index([userId]): LinksService.findAll filters by userId AND orders by
  // createdAt desc with skip/take - one index scan serves filter + sort + pagination. The
  // leftmost prefix (userId) still covers any userId-only lookup, so no separate index needed.
  @@index([userId, createdAt])
}

model Click {
  id           String    @id @default(uuid())
  linkId       String
  link         Link      @relation(fields: [linkId], references: [id], onDelete: Cascade)
  clickedAt    DateTime  @default(now())
  referrer     String?
  userAgentRaw String?
  browser      String?
  os           String?
  deviceType   DeviceType @default(UNKNOWN)

  @@index([linkId, clickedAt])
}

enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  BOT
  UNKNOWN
}

// Server-side JWT revocation — a token's `jti` lands here on explicit logout, checked by
// JwtStrategy on every request. Without this, "logout" was purely client-side (deleting the
// token from localStorage) - a leaked token stayed valid for its full life regardless. Rows
// past their own token's expiry are cleanup candidates (deleted lazily on next logout, see
// AuthController) - no need to keep them once the token itself would fail on expiry anyway.
model RevokedToken {
  jti       String   @id
  expiresAt DateTime

  @@index([expiresAt])
}
