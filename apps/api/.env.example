# Copy to apps/api/.env and adjust if needed. Values below match the default
# docker-compose credentials (see root .env.example) — fine for local dev.

DATABASE_URL="postgresql://linkshortener:linkshortener@localhost:5432/linkshortener"
PORT=4000

# --- Stage 4 (Authentication) ---
# Real values required to actually exercise the Google login flow — see "Как получить Google
# OAuth credentials" in docs/stage-4-authentication.md. Everything else (JWT issuance, guards,
# per-user data scoping) works and is testable without real Google credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Generate your own: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
